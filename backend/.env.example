# 灵枢 · 智能体平台 —— 环境变量模板
#
# 用法：cp .env.example .env，然后按需填写。.env 已在 .gitignore 中，不会入库。
# 每一项都可用环境变量覆盖（pydantic-settings 按字段名大写读取）。

# ===== 安全 =====
# SECRET_KEY 必须 >=32 字符的随机值；用模板值或长度不足时服务会拒绝启动（fail-fast）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_PLUS_CHARS
# 密钥轮换时的上一枚密钥（旧 token 的验证窗口，留空表示不轮换）
SECRET_KEY_PREV=
SECRET_KEY_PREV_SINCE=
JWT_EXPIRE_DAYS=7
# 公网 HTTPS 部署必须置 true（cookie 带 Secure 标记）；局域网 HTTP 保持 false，否则浏览器不发 cookie、无法登录
# COOKIE_SECURE=false
# 反代场景的可信代理白名单（逗号分隔）。Nginx 反代时置 127.0.0.1；留空 = 不信任 XFF、一律取直连 IP
# TRUSTED_PROXIES=
# 通用限流（次/分钟）
# RATE_LIMIT_ASK_PER_MIN=30
# RATE_LIMIT_CAPTCHA_PER_MIN=30
# RATE_LIMIT_LOGIN_PER_MIN=60
# LLM 输出侧的恶意载荷屏蔽开关
# OUTPUT_GUARD_MALICIOUS=true

# ===== 数据库 =====
# 库名前缀需与 DB_NAME_PREFIX 一致（代码拼 CREATE/DROP/备份库名时会用它）
GLOBAL_DB_URL=postgresql+asyncpg://aip:aip_dev_pass@localhost:5432/ai_platform_tardis
DEPT_DB_URL_TEMPLATE=postgresql+asyncpg://aip:aip_dev_pass@localhost:5432/tardis_dept_{dept_id}_db
CEO_DB_URL=postgresql+asyncpg://aip:aip_dev_pass@localhost:5432/tardis_ceo_db
DB_NAME_PREFIX=tardis_

# ===== Redis =====
# 与同机其他实例共用一套 Redis 时，用不同的库号隔离
REDIS_URL=redis://localhost:6379/1
# 配了 redis.conf 的 requirepass 时填这里
# REDIS_PASSWORD=

# ===== DeepSeek（文本推理）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CEO=deepseek-flash
DEEPSEEK_MODEL_EMPLOYEE=deepseek-flash
# 思考强度：low / high / max
REASONING_EFFORT_CEO=max
REASONING_EFFORT_EMPLOYEE=high

# ===== 智谱 GLM（视觉理解 / 图片生成）=====
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_VISION_MODEL=glm-4.1v-thinking-flash
GLM_IMAGE_MODEL=cogview-3-flash

# ===== Agnes（多模态备选档）=====
# AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ===== 公网入口 =====
# 视频理解需要模型侧经公网拉取本地视频；配了命名隧道就填这里。
# 未配置时会自动降级为 cloudflared 临时隧道（见 TMP_TUNNEL_ENABLED）。
# PUBLIC_BASE_URL=https://your-domain.example.com

# ===== 数据目录 =====
UPLOAD_DIR=/data/tardis/uploads
OUTPUT_DIR=/data/tardis/outputs
BACKUP_DIR=/data/tardis/backups
LOG_DIR=/data/tardis/logs
TEMP_DIR=/data/tardis/tmp
MAX_UPLOAD_SIZE_MB=100

# ===== API 前缀 =====
# 消费方统一走 core/url_utils.py，不要在代码里硬编码
API_PREFIX=/api/v1
# 前端 dev 代理目标（frontend/vite.config.ts 读取）
# VITE_API_PROXY_TARGET=http://127.0.0.1:8001

# ===== CORS（逗号分隔；与 CSRF 的 Origin 白名单同源）=====
# CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ===== 告警推送（留空则跳过；机器人开启签名时配 ALERT_SIGN_SECRET）=====
ALERT_WEBHOOK_URL=
# ALERT_SIGN_SECRET=

# ===== Agent 引擎 =====
# 工具轮硬上限。注意 graph.py 里还有一层 max(配置值, 20) 的下限，所以填小于 20 无效
MAX_TOOL_ROUNDS=40

# ===== 沙盒 =====
# 沙盒默认断网；也可由管理员在后台改 system_config 的 sandbox_net_enabled
# SANDBOX_NET_ENABLED=false
# SANDBOX_NODE_MEMORY_MB=2048
# 以下五项是沙盒/技能执行用到的解释器与二进制绝对路径。
# 留空则使用 config.py 里的中性默认值；**本机安装路径与默认值不同时必须在此覆盖**。
# AIP_PYTHON=/path/to/conda/envs/aip/bin/python3.12
# SKILLENV_PYTHON=/path/to/conda/envs/skillenv/bin/python
# NODE_PATH=/path/to/node/bin/node
# OFFICECLI_BIN_DIR=/path/to/bin
# CLOUDFLARED_BIN=/path/to/bin/cloudflared

# ===== 联网搜索 =====
WEBSEARCH_DEEPSEEK_PATH=npx
